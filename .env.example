# Template for local development and deployment. Copy to .env; never commit .env.

# Public domain for HTTPS (DNS A record must point at this server)
DOMAIN=coffee.example.com

# Required in production. Generate with: openssl rand -hex 32
JWT_SECRET=

# Admin account settings apply only when the database has no admin account.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-unique-password
